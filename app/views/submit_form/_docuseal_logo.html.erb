<%# Saccade, 2026-11-24: DocuSeal mark hidden where the "Powered by DocuSeal" line is on the page; full Saccade Media House logo (PNG /saccade-media-house-logo.png). 2026-11-21: compact header "Saccade | DocuSeal" instead of the large DocuSeal logo. Modification of DocuSeal 3.3.8 (AGPL-3.0); source: https://github.com/warlock9k00/docuseal-saccade. The Saccade logo is its owner's trademark and is not licensed under AGPL. %>
<div id="saccade-brand-row" class="flex justify-start items-center" style="gap:9px;width:100%">
  <span class="flex items-center" style="gap:9px" role="img" aria-label="Saccade Media House"><img src="/saccade-media-house-logo.png" alt="" aria-hidden="true" width="182" height="28" style="display:block;max-width:100%;height:auto"></span>
  <span class="sds-hide" aria-hidden="true" style="width:1px;height:20px;background:currentColor;opacity:.18;margin:0 4px"></span>
  <a href="<%= root_path %>" class="sds-hide flex items-center opacity-70" style="gap:5px">
    <%= render 'shared/logo', width: '16px', height: '16px' %>
    <span class="text-sm font-semibold"><%= Docuseal.product_name %></span>
  </a>
  <%# policy links: DocuSeal pins them to the bottom-right corner on desktop as an 8rem column; our notice is long, so on desktop it goes under the document as on phones. Inside the flex row so it adds no spacing %>
  <style>@media (min-width:768px){div[class~="md:fixed"][class~="md:right-0"][class~="md:bottom-0"]{position:static!important;max-width:42rem;margin:1rem auto 0!important;padding:0 1rem!important;text-align:center!important}div[class~="md:fixed"][class~="md:right-0"][class~="md:bottom-0"]>div{max-width:none!important;flex-direction:row!important;justify-content:center!important;align-items:center!important}}</style>
  <%# Saccade, 2026-11-24 (Sasha: DocuSeal out of the header except the code screens): the DocuSeal mark is hidden only where the page
      itself carries DocuSeal's original attribution line ("Powered by DocuSeal", shared/_powered_by, link to docuseal.com).
      Code, error and other screens without that line keep the mark (LICENSE_ADDITIONAL_TERMS, AGPL 7(b)). No :has support -> mark stays. %>
  <style>body:has(a.underline[href^="https://www.docuseal.com"]) .sds-hide{display:none!important}</style>
  <%# Saccade, 2026-11-24 (Sasha: every text link underlined, plain-looking links read as text): links without a class are text
      links (Policy Links, markdown in step descriptions); buttons, logos and the EN|RU switch carry classes and are not touched. %>
  <style>a[href]:not([class]){text-decoration:underline!important;text-underline-offset:2px}</style>
  <%= render 'shared/saccade_lang' %>
  <%# Saccade, 2026-11-21: header A (decision of Sasha). One sticky row at every width: Saccade mark | DocuSeal · document name ·
      EN|RU · Decline · Download; 56 px on desktop, 52 px on a phone (there: mark | DocuSeal icon, Decline as ✕). DocuSeal 3.3.8
      makes #signing_form_header static from 1230 px and shows floating buttons instead (scroll-buttons); with the header
      always visible those never appear. The script moves our brand into the header and hides the logo row above it; if
      anything is missing it changes nothing, and the row with the DocuSeal attribution stays as it was. %>
  <style>
    <%# full-width background and bottom line come from box-shadow and border-image outset: these paint past the edges without
        widening the page (an absolutely placed 100vmax line did, and the page scrolled sideways from 768 px) %>
    html.shdr #signing_form_header{position:sticky!important;top:0;height:56px;padding:0 4px!important;gap:14px;margin-bottom:0!important;box-shadow:0 0 0 100vmax var(--shdr-bg,#fff);border-image:linear-gradient(to top,#e7e1ec 1px,transparent 1px) fill 0//0 100vmax;clip-path:inset(0 -100vmax)}
    html.shdr #signing_form_header h1{font-size:18px!important;font-weight:600!important;line-height:1.2!important;min-width:0;flex:1}
    html.shdr #signing_form_header>div.group{margin-left:0!important}
    <%# DocuSeal's md:-mx-[8px] pushes the header 8 px past the window until the 1000 px column has room (1000 + 2*8 + 15 scrollbar) %>
    @media (min-width:768px) and (max-width:1031px){html.shdr #signing_form_header{margin-left:0!important;margin-right:0!important;padding:0 12px!important}}
    .shdr-brand{display:flex;align-items:center;gap:8px;flex-shrink:0}
    .shdr-sac{display:flex;align-items:center;gap:7px}
    .shdr-logo{display:block;height:24px;width:auto;max-width:none}
    <%# 24.11 (Sasha): on a phone the header shows only the Saccade dots mark (/saccade-mark.svg), the full logo from 768 px %>
    .shdr-mark{display:none;height:26px;width:auto;max-width:none}
    .shdr-bar{width:1px;height:18px;background:currentColor;opacity:.18;flex-shrink:0}
    .shdr-ds{display:flex;align-items:center;gap:5px;opacity:.6;flex-shrink:0}
    .shdr-dst{font-size:13px;font-weight:600}
    @media (max-width:767px){
      html.shdr #signing_form_header{height:52px;padding:0 12px!important;gap:10px}
      html.shdr #signing_form_header h1{font-size:16px!important}
      .shdr-word,.shdr-dst,.shdr-bar2,.shdr-dl{display:none!important}
      .shdr-logo{display:none!important}
      .shdr-mark{display:block}
      html.shdr #decline_button{padding:0 10px!important}
    }
    @media (min-width:768px){.shdr-xi{display:none}}
    <%# 24.11: DocuSeal's dark label over the active field ("Full name (as in passport…)") runs past the page edge when the field
        is on the right; on a phone the page then got wider than the screen (429 px of 390) and the header's right end went off-screen.
        Clip it at the PDF page edge, sideways only %>
    [id^="page-"]{overflow-x:clip}
  </style>
  <script nonce="<%= content_security_policy_nonce %>">
  (function () {
    if (window.__saccadeHdr) return;
    window.__saccadeHdr = true;
    var XSVG = '<svg class="shdr-xi" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>';
    var done = false;
    function el (tag, cls) { var e = document.createElement(tag); if (cls) e.className = cls; return e; }
    function sized (svg, h, ratio) { var s = svg.cloneNode(true); s.setAttribute('height', h); s.setAttribute('width', Math.round(h * ratio)); return s; }
    function build () {
      if (done) return true;
      var h = document.getElementById('signing_form_header'), row = document.getElementById('saccade-brand-row');
      // the header is complete once the element after it (scroll-buttons) is parsed
      if (!h || !row || (!h.nextElementSibling && document.readyState === 'loading')) return false;
      done = true;
      var h1 = h.querySelector('h1'), box = h1 && h1.nextElementSibling, sac = row.querySelector('[aria-label^="Saccade"]'), ds = row.querySelector('a');
      var logo = sac ? sac.querySelector('img') : null;
      if (!h1 || !box || !logo || !ds || !ds.querySelector('svg') || !window.SaccadeLang) return true;
      var brand = el('span', 'shdr-brand'), s = el('span', 'shdr-sac');
      s.setAttribute('role', 'img'); s.setAttribute('aria-label', 'Saccade Media House');
      var w = logo.cloneNode(true); w.removeAttribute('style'); w.setAttribute('class', 'shdr-logo'); s.appendChild(w);
      var m = el('img', 'shdr-mark'); m.src = '/saccade-mark.svg'; m.alt = ''; m.setAttribute('aria-hidden', 'true'); m.width = 16; m.height = 26; s.appendChild(m);
      var a = el('a', 'shdr-ds'); a.href = ds.getAttribute('href'); a.title = 'DocuSeal'; a.setAttribute('aria-label', 'DocuSeal');
      a.appendChild(sized(ds.querySelector('svg'), 14, 1));
      var dt = el('span', 'shdr-dst'); dt.textContent = 'DocuSeal'; a.appendChild(dt);
      brand.appendChild(s); brand.appendChild(el('span', 'shdr-bar sds-hide')); a.className += ' sds-hide'; brand.appendChild(a);
      h.insertBefore(brand, h1);
      h.insertBefore(el('span', 'shdr-bar shdr-bar2'), h1);
      box.insertBefore(window.SaccadeLang.seg(), box.firstChild);
      var db = document.getElementById('decline_button');
      if (db && !db.querySelector('svg')) {
        var txt = db.textContent.trim(), sp = el('span', 'shdr-dl');
        sp.textContent = txt; db.textContent = ''; db.appendChild(sp); db.insertAdjacentHTML('beforeend', XSVG); db.setAttribute('aria-label', txt);
      }
      h.style.setProperty('--shdr-bg', getComputedStyle(h).backgroundColor);
      if (row.parentElement) row.parentElement.style.display = 'none';
      document.documentElement.classList.add('shdr');
      return true;
    }
    if (!build()) {
      var mo = new MutationObserver(function () { if (build()) mo.disconnect(); });
      mo.observe(document.documentElement, { childList: true, subtree: true });
      document.addEventListener('DOMContentLoaded', function () { build(); mo.disconnect(); });
    }
  })();
  </script>
  <%# Saccade, 2026-11-24 (Sasha, "check everywhere" about phone keyboards): DocuSeal renders every text field as a plain text input.
      Fields named like e-mail get the e-mail keyboard (@ and .) and the address suggestion; type stays "text" so DocuSeal's
      own handling of the input is unchanged. Names/addresses are left alone: the form asks for Latin and a country, and
      phone autofill would offer the contact card as is. %>
  <script nonce="<%= content_security_policy_nonce %>">
  (function () {
    if (window.__saccadeKb) return;
    window.__saccadeKb = true;
    var mail = null;
    function apply () {
      var host = document.querySelector('submission-form');
      if (!host) return;
      if (!mail) {
        mail = {};
        try { JSON.parse(host.dataset.fields || '[]').forEach(function (f) { if (f.type === 'text' && /e-?mail|почт/i.test(f.name || '')) mail[f.uuid] = 1; }); } catch (e) {}
      }
      Object.keys(mail).forEach(function (u) {
        var i = document.getElementById(u);
        if (!i || i.tagName !== 'INPUT' || i.getAttribute('inputmode') === 'email') return;
        i.setAttribute('inputmode', 'email'); i.setAttribute('autocomplete', 'email');
        i.setAttribute('autocapitalize', 'off'); i.setAttribute('autocorrect', 'off'); i.setAttribute('spellcheck', 'false');
      });
    }
    var mo = new MutationObserver(function () { try { apply(); } catch (e) {} });
    function start () { apply(); mo.observe(document.body, { childList: true, subtree: true }); }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start); else start();
  })();
  </script>
  <%# Saccade, 2026-11-21: field navigator ("B — list of fields", chosen by Sasha). Desktop with room on the left: a card with all
      fields, their page and progress; phone or narrow window: a bar under the header "N left · Next: …" that opens the list.
      A tap moves DocuSeal to that step through its own progress dots, so DocuSeal still does the saving and scrolling.
      Reads only DocuSeal's markup (data-fields on <submission-form>, the field areas, the progress dots); after a DocuSeal
      update check the form, see docs/infra/docuseal-deploy.md. Inline scripts need the CSP nonce. %>
  <script nonce="<%= content_security_policy_nonce %>">
  (function () {
    if (window.__saccadeNav) return;
    window.__saccadeNav = true;
    var ACC = '#291334', DONE = '#12b76a', LINE = '#e7e1ec', MUTED = '#8a7f95', INK = '#1e252d';
    var CHECK = '<svg width="10" height="10" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2.5 6.2l2.3 2.3 4.7-5" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
    function T (en, ru) { return window.SaccadeLang ? window.SaccadeLang.t(en, ru) : en; }
    var host = null, steps = null, plainSteps = true, root = null, open = false, lastSig = '', initVals = {};

    function esc (s) { return String(s).replace(/[&<>"']/g, function (c) { return '&#' + c.charCodeAt(0) + ';'; }); }
    function empty (v) { return v === null || v === undefined || v === '' || (Array.isArray(v) && !v.length); }
    function label (f) {
      var n = (f.title || f.name || f.type || '').replace(/\s*\(.*\)\s*$/, '').replace(/,\s+if\s.*$/i, '');
      return n.charAt(0).toUpperCase() + n.slice(1);
    }

    // the same steps as DocuSeal's form.vue stepFields (3.3.8): field order, verification last, plain checkboxes grouped
    function buildSteps () {
      var fields = JSON.parse(host.dataset.fields || '[]'), ver = [], out = [];
      var list = fields.filter(function (f) {
        if (f.type === 'verification' || f.type === 'kba') { ver.push(f); return false; }
        return !f.readonly;
      });
      if (ver.length) list.push(ver.pop());
      list.forEach(function (f) {
        if ((f.conditions || []).length) plainSteps = false;
        var prev = out[out.length - 1];
        if (f.type === 'checkbox' && prev && prev[0].type === 'checkbox' && !f.description) prev.push(f); else out.push([f]);
      });
      return out;
    }

    function areaEl (a) {
      var p = document.getElementById('page-' + a.attachment_uuid + '-' + a.page);
      if (!p) return null;
      var ty = a.y * 100, tx = a.x * 100, els = p.querySelectorAll('[style*="top"]');
      for (var i = 0; i < els.length; i++) {
        var st = els[i].style;
        if (st.top && st.left && Math.abs(parseFloat(st.top) - ty) < 0.02 && Math.abs(parseFloat(st.left) - tx) < 0.02) return els[i];
      }
      return null;
    }

    function filled (f) {
      if (f.type === 'radio') return !!document.querySelector('input[name="radio-area-' + f.uuid + '"]:checked');
      var els = (f.areas || []).map(areaEl).filter(Boolean);
      if (!els.length) return !empty(initVals[f.uuid]);
      return els.some(function (e) {
        if (e.querySelector('input:checked') || e.querySelector('img')) return true;
        if (['checkbox', 'multiple', 'signature', 'initials', 'image', 'stamp', 'file'].indexOf(f.type) >= 0) return false;
        var t = e.innerText.trim().toLowerCase(), n = (f.name || '').toLowerCase();
        return !!t && n.indexOf(t.slice(0, 12)) !== 0 && t.indexOf('type here') !== 0;
      });
    }

    // DocuSeal 3.3.8: header #signing_form_header is sticky z-50 (static from 1230 px), the step form sits in a fixed z-50 layer
    function topOffset () {
      var h = document.getElementById('signing_form_header');
      if (h && h.getBoundingClientRect().height > 0) return Math.max(8, Math.round(h.getBoundingClientRect().bottom) + (document.documentElement.classList.contains('shdr') ? 12 : 26));
      var b = [].slice.call(document.querySelectorAll('button,a,label')).filter(function (x) {
        return /^\s*decline\s*$/i.test(x.innerText) && x.getBoundingClientRect().height > 0;
      })[0] || document.querySelector('[aria-label^="Saccade"]');
      return b ? Math.max(8, Math.round(b.getBoundingClientRect().bottom) + 10) : 16;
    }

    function state () {
      var dots = [].slice.call(document.querySelectorAll('.steps-progress button'));
      var nav = document.querySelector('.steps-progress');
      var completed = !!(nav && nav.closest('nav[aria-hidden="true"]'));
      var cur = -1;
      dots.forEach(function (d, i) { if (/steps-progress-current/.test(d.className)) cur = i; });
      var rows = steps.map(function (st, i) {
        var req = st.some(function (f) { return f.required; });
        var a = st[0].areas && st[0].areas[0];
        var done = req ? st.every(function (f) { return !f.required || filled(f); }) : st.some(filled);
        return { i: i, label: st.length > 1 ? label(st[0]) + ' +' + (st.length - 1) : label(st[0]), page: a ? a.page + 1 : null, req: req, done: done, cur: i === cur };
      });
      var todo = rows.filter(function (r) { return r.req && !r.done; });
      var page = document.querySelector('[id^="page-"]');
      return { rows: rows, todo: todo, next: todo[0] || null, completed: completed, dotsOk: plainSteps && dots.length === steps.length,
        // the card may sit on the PDF's white margin (~8% of the page width), never over the text
        mobile: innerWidth < 768, textLeft: page ? Math.round(page.getBoundingClientRect().left + page.getBoundingClientRect().width * 0.08) : 0, top: topOffset() };
    }

    function rowHtml (r, s) {
      var mark = r.done
        ? '<span class="snav-mk" style="background:' + DONE + ';border-color:' + DONE + '">' + CHECK + '</span>'
        : '<span class="snav-mk" style="border-style:' + (r.req ? 'solid' : 'dashed') + ';border-color:' + (r.req ? ACC : '#b9aec4') + (r === s.next ? ';background:' + ACC : '') + '"></span>';
      return '<button type="button" class="snav-row' + (r.cur ? ' snav-cur' : '') + '" data-step="' + r.i + '">' + mark +
        '<span class="snav-lb" style="' + (r.done ? 'color:' + MUTED : (r === s.next ? 'font-weight:700' : '')) + '">' + esc(r.label) +
        (r.req ? '' : ' <span style="color:' + MUTED + ';font-weight:400">· ' + T('optional', 'необязательно') + '</span>') + '</span>' +
        '<span class="snav-pg">' + (r.page ? T('p.', 'с.') + r.page : '') + '</span></button>';
    }

    // 21.11 (Sasha): DocuSeal's step dots fill only for steps before the current one. Paint them like the list:
    // green = filled, dark = next to fill, white = to fill, dashed = optional, ring = current step.
    function paintDots (s) {
      var dots = document.querySelectorAll('.steps-progress button');
      [].forEach.call(dots, function (d, i) {
        var r = s.dotsOk && !s.completed ? s.rows[i] : null;
        var v = !r ? null : r.done ? 'done' : r === s.next ? 'next' : r.req ? 'todo' : 'opt';
        if (!v) { if (d.hasAttribute('data-snav')) d.removeAttribute('data-snav'); return; }
        if (d.getAttribute('data-snav') !== v) d.setAttribute('data-snav', v);
      });
    }

    // 21.11 (Sasha): the last step says "signature is in place … press Complete" even when required fields are empty
    // (Complete then only jumps to the first empty one). Show what is missing above that text.
    function warnLast (s) {
      var form = document.getElementById('steps_form'), box = document.getElementById('snav-warn');
      var cur = s.rows.filter(function (r) { return r.cur; })[0];
      var miss = cur && cur.i === s.rows.length - 1 && !s.completed ? s.todo.filter(function (r) { return r !== cur; }) : [];
      if (!form || !miss.length) { if (box) box.remove(); return; }
      var key = T('en', 'ru') + ':' + miss.map(function (r) { return r.i; }).join(',');
      if (box && box.parentNode === form.parentNode && box.getAttribute('data-k') === key) return;
      if (box) box.remove();
      box = document.createElement('div');
      box.id = 'snav-warn'; box.setAttribute('role', 'alert'); box.setAttribute('data-k', key);
      var n = miss.length, names = miss.slice(0, 4).map(function (r) { return esc(r.label); }).join(', ') + (n > 4 ? ', …' : '');
      box.innerHTML = '<div><b>' + T('Not ready to send: ' + n + ' required field' + (n > 1 ? 's are' : ' is') + ' still empty',
        'Отправить пока нельзя: не заполнено обязательных полей — ' + n) + '</b> (' + names + ').</div>' +
        '<button type="button" data-step="' + miss[0].i + '">' + T('Go to “' + esc(miss[0].label) + '” →', 'Перейти к «' + esc(miss[0].label) + '» →') + '</button>';
      box.querySelector('button').addEventListener('click', function () { go(miss[0].i); });
      form.parentNode.insertBefore(box, form);
    }

    function render () {
      var s = state();
      paintDots(s); warnLast(s);
      var show = !s.completed && s.rows.length >= 3 && document.querySelector('[id^="page-"]');
      var card = !s.mobile && s.textLeft >= 16 + 236 + 12;
      var sig = JSON.stringify([T('en', 'ru'), show, card, open, s.top, s.textLeft, s.rows]);
      if (sig === lastSig) return;
      lastSig = sig;
      root.__s = s;
      if (!show) { root.innerHTML = ''; return; }
      var done = s.rows.filter(function (r) { return r.done; }).length, pct = Math.round(done / s.rows.length * 100);
      var head = '<div class="snav-hd"><span>' + (s.todo.length ? T('To fill: ' + s.todo.length + ' left', 'Осталось заполнить: ' + s.todo.length) : T('All required fields filled', 'Все обязательные поля заполнены')) + '</span><span class="snav-ct">' + done + ' / ' + s.rows.length + '</span></div>' +
        '<div class="snav-bar"><div style="width:' + pct + '%"></div></div>';
      var list = s.rows.map(function (r) { return rowHtml(r, s); }).join('');
      if (card) {
        var w = 236, left = Math.max(16, Math.round((s.textLeft - 12 - w) / 2));
        root.innerHTML = '<nav aria-label="' + T('Fields to fill', 'Поля для заполнения') + '" class="snav-card" style="left:' + left + 'px;top:' + s.top + 'px;width:' + w + 'px;max-height:calc(100vh - ' + (s.top + 16) + 'px)">' + head + list + '</nav>';
      } else {
        var nx = s.next ? T('Next: ', 'Далее: ') + esc(s.next.label) + (s.next.page ? ' <span style="color:' + MUTED + ';font-weight:400">· ' + T('p.', 'с.') + s.next.page + '</span>' : '') : T('All required fields filled', 'Все обязательные поля заполнены');
        root.innerHTML = '<nav aria-label="' + T('Fields to fill', 'Поля для заполнения') + '" class="snav-top' + (open ? ' snav-open' : '') + '" style="top:' + s.top + 'px;' + (s.mobile ? 'left:12px;right:12px' : 'left:16px;width:380px') + '">' +
          '<button type="button" class="snav-tg" data-toggle="1" aria-expanded="' + open + '">' +
          (s.todo.length ? '<span class="snav-pill">' + T(s.todo.length + ' left', 'ещё ' + s.todo.length) + '</span>' : '<span class="snav-pill" style="background:' + DONE + '">' + CHECK + '</span>') +
          '<span class="snav-nx">' + nx + '</span><span class="snav-ch">' + (open ? '&#x2303;' : '&#x2304;') + '</span></button>' +
          (open ? '<div class="snav-dd">' + head + list + '</div>' : '') + '</nav>';
        // 24.11 (Sasha): the fixed bar covered the top of page 1; the header's bottom margin (CSS below) reserves its height
        var tg = root.querySelector('.snav-tg');
        if (tg) document.documentElement.style.setProperty('--snav-h', tg.offsetHeight + 'px');
      }
    }

    function go (i) {
      var s = root.__s;
      var exp = document.getElementById('expand_form_button');
      var wait = exp && exp.getBoundingClientRect().height > 0 ? (exp.click(), 250) : 0;
      setTimeout(function () {
        var dots = document.querySelectorAll('.steps-progress button');
        if (s && s.dotsOk && dots[i]) { dots[i].click(); return; }
        var a = steps[i][0].areas && steps[i][0].areas[0], el = a && areaEl(a);
        if (el) { el.scrollIntoView({ block: 'center', behavior: 'smooth' }); if (el.getAttribute('role') === 'button') el.click(); }
      }, wait);
    }

    function boot () {
      host = document.querySelector('submission-form');
      if (!host || !host.dataset.fields) return false;
      steps = buildSteps();
      try { initVals = JSON.parse(host.dataset.values || '{}') || {}; } catch (e) { initVals = {}; }
      var css = document.createElement('style');
      css.textContent = [
        '.snav-card,.snav-top{position:fixed;z-index:35;color:' + INK + ';font-size:13px;line-height:1.25}.snav-top.snav-open{z-index:51}',
        '.snav-card{background:#fff;border:1px solid ' + LINE + ';border-radius:14px;padding:14px 8px 8px;box-shadow:0 6px 24px rgba(30,37,45,.08);overflow:auto}',
        '.snav-hd{display:flex;justify-content:space-between;align-items:baseline;gap:8px;padding:0 8px;font-weight:700}',
        '.snav-ct{font-weight:400;font-size:12px;color:' + MUTED + '}',
        '.snav-bar{height:4px;border-radius:2px;background:' + LINE + ';margin:8px 8px 6px}.snav-bar>div{height:4px;border-radius:2px;background:' + DONE + '}',
        // 21.11 (Sasha, ALL3): a long step text made the step window taller than the screen, its top with the minimize
        // button went off-screen and nothing could be closed. Cap the window, scroll the text inside it.
        '#form_container{display:flex;flex-direction:column;max-height:calc(100vh - 96px);max-height:calc(100dvh - 96px)}',
        // 24.11 (Sasha, phone: the step text scrolled sideways and was cut on the left): overflow-y:auto made overflow-x auto too,
        // and DocuSeal's hidden tooltip next to the text field is ~50 px wider than the window. Vertical scrolling only.
        '#form_container>div{overflow-y:auto;overflow-x:hidden;min-height:0;overscroll-behavior:contain}',
        // the tooltip itself ("Toggle Multiline Text", centred over a button at the right edge): open it leftwards from the button
        '#form_container .tooltip::before{left:auto!important;right:0!important;transform:none!important}',
        // with the sticky header A and the navigator bar under it, keep the step window below the bar
        'body:has(.snav-top) #form_container{max-height:calc(100vh - 124px);max-height:calc(100dvh - 124px)}',
        // 24.11 (Sasha: "the menu covers the header"): at the top of the page the document starts below the bar, not under it
        // (bar = header bottom + 12 px, its height --snav-h, then 8 px)
        'html.shdr body:has(.snav-top) #signing_form_header{margin-bottom:calc(var(--snav-h, 40px) + 20px)!important}',
        '.steps-progress button[data-snav]{background:#fff!important;border-color:' + ACC + '!important}',
        '.steps-progress button[data-snav=done]{background:' + DONE + '!important;border-color:' + DONE + '!important}',
        '.steps-progress button[data-snav=next]{background:' + ACC + '!important}',
        '.steps-progress button[data-snav=opt]{border-style:dashed!important;border-color:#b9aec4!important}',
        '.steps-progress button[data-snav][aria-current=step]{box-shadow:0 0 0 2px #fff,0 0 0 3.5px ' + ACC + '}',
        '#snav-warn{margin:0 0 12px;padding:10px 12px;border-radius:10px;background:#fff7ed;border:1px solid #fdba74;color:#9a3412;font-size:14px;line-height:1.35}',
        '#snav-warn button{margin-top:8px;padding:6px 12px;border-radius:8px;background:' + ACC + ';color:#fff;font-weight:600;font-size:13px}',
        '.snav-row{display:flex;width:100%;align-items:center;gap:10px;padding:7px 8px;border-radius:8px;text-align:left;cursor:pointer;background:none}',
        '.snav-row:hover{background:rgba(41,19,52,.05)}.snav-row.snav-cur{background:rgba(41,19,52,.08)}',
        '.snav-mk{flex:none;width:18px;height:18px;border-radius:50%;border:2px solid;display:flex;align-items:center;justify-content:center}',
        '.snav-lb{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:500}',
        '.snav-pg{flex:none;font-size:11px;color:' + MUTED + '}',
        '.snav-tg{display:flex;width:100%;align-items:center;gap:10px;background:#fff;border:1px solid ' + LINE + ';border-radius:12px;padding:8px 12px;box-shadow:0 4px 16px rgba(30,37,45,.10);cursor:pointer;text-align:left}',
        '.snav-pill{flex:none;display:inline-flex;align-items:center;justify-content:center;min-width:22px;background:' + ACC + ';color:#fff;border-radius:999px;font-size:12px;font-weight:600;padding:4px 9px}',
        '.snav-nx{flex:1;min-width:0;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}',
        '.snav-ch{flex:none;font-size:16px;color:' + MUTED + '}',
        '.snav-dd{margin-top:6px;background:#fff;border:1px solid ' + LINE + ';border-radius:12px;padding:10px 4px 4px;box-shadow:0 8px 24px rgba(30,37,45,.12);max-height:55vh;overflow:auto}'
      ].join('\n');
      document.head.appendChild(css);
      root = document.createElement('div');
      root.id = 'saccade-field-nav';
      document.body.appendChild(root);
      root.addEventListener('click', function (e) {
        var t = e.target.closest('[data-toggle],[data-step]');
        if (!t) return;
        if (t.dataset.toggle) { open = !open; render(); return; }
        open = false;
        go(+t.dataset.step);
        render();
      });
      ['scroll', 'resize', 'input', 'change', 'click'].forEach(function (ev) { addEventListener(ev, function () { setTimeout(safe, 50); }, { passive: true, capture: true }); });
      setInterval(safe, 800);
      if (window.SaccadeLang) window.SaccadeLang.onChange(function () { lastSig = ''; safe(); });
      return true;
    }

    function safe () { try { render(); } catch (e) { if (window.console) console.warn('saccade nav', e); } }
    function start () { try { if (boot()) safe(); } catch (e) { if (window.console) console.warn('saccade nav', e); } }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start); else setTimeout(start, 0);
  })();
  </script>
</div>
