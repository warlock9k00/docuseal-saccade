<%# Saccade, 2026-11-24: brand row full width, logo flush left with the form (Sasha: no centring). DocuSeal mark hidden where the "Powered by DocuSeal" line is on the page. 2026-11-21: compact header "Saccade | DocuSeal" instead of the large DocuSeal logo. Modification of DocuSeal 3.3.8 (AGPL-3.0); source: https://github.com/warlock9k00/docuseal-saccade. The Saccade logo is its owner's trademark and is not licensed under AGPL. %>
<div id="saccade-brand-row" class="flex justify-start items-center" style="gap:9px;width:100%">
  <span class="flex items-center" style="gap:9px" role="img" aria-label="Saccade Media House"><img src="/saccade-media-house-logo.png" alt="" aria-hidden="true" width="182" height="28" style="display:block;max-width:100%;height:auto"></span>
  <span class="sds-hide" aria-hidden="true" style="width:1px;height:20px;background:currentColor;opacity:.18;margin:0 4px"></span>
  <a href="/" class="sds-hide flex items-center opacity-70" style="gap:5px">
    <%= render 'shared/logo', width: '16px', height: '16px' %>
    <span class="text-sm font-semibold">DocuSeal</span>
  </a>
  <%# same 16px top offset as the signing form header (DocuSeal wraps these screens in mt-12); kept inside the flex row so it adds no spacing %>
  <style>.mt-12:has([aria-label^="Saccade"]){margin-top:1rem}</style>
  <%# Saccade, 2026-11-24 (Sasha: DocuSeal out of the header except the code screens): the DocuSeal mark is hidden only where the page
      itself carries DocuSeal's original attribution line ("Powered by DocuSeal", shared/_powered_by, link to docuseal.com).
      Code, error and other screens without that line keep the mark (LICENSE_ADDITIONAL_TERMS, AGPL 7(b)). No :has support -> mark stays. %>
  <style>body:has(a.underline[href^="https://www.docuseal.com"]) .sds-hide{display:none!important}</style>
  <%# Saccade, 2026-11-24 (Sasha: every text link underlined, plain-looking links read as text): links without a class are text
      links (Policy Links, markdown in step descriptions); buttons, logos and the EN|RU switch carry classes and are not touched. %>
  <style>a[href]:not([class]){text-decoration:underline!important;text-underline-offset:2px}</style>
  <%= render 'shared/saccade_lang' %>
  <%# Saccade, 2026-11-21: the same EN/RU switch as in the signing header, at the end of this row: the start page asks for the
      e-mail before the form, and the short notice under Start (Policy Links) must be readable in the chosen language. %>
  <script nonce="<%= content_security_policy_nonce %>">
    (function () {
      var row = document.getElementById('saccade-brand-row');
      if (!row || !window.SaccadeLang || row.querySelector('.slang-seg')) return;
      var g = window.SaccadeLang.seg();
      g.style.marginLeft = 'auto'; // 2026-11-24: logo flush left with the form, EN|RU at the right edge
      row.appendChild(g);
    })();
  </script>
</div>
<%# Saccade, 2026-11-21: email code screen. DocuSeal shows "Code has been re-sent" as small plain text, easy to miss.
    Show it as a green status line with the address, and pause "Re-send Code" for 45 s: DocuSeal sends at most
    2 code e-mails per 45 s per IP, a 3rd click only returns "Too many attempts". %>
<% code_sent = flash[:notice].present? && flash[:notice] == I18n.t(:code_has_been_resent) %>
<% code_limited = flash[:alert].present? && flash[:alert] == I18n.t(:too_many_attempts) %>
<% if code_sent || code_limited %>
  <% code_email = (params[:email].presence || params.dig(:submitter, :email)).to_s %>
  <% code_text = if !code_sent
                   { en: '', ru: '' }
                 elsif I18n.locale.to_s.start_with?('en') && code_email.present?
                   { en: "New code sent to #{code_email}. It may take a minute to arrive, please check Spam too.",
                     ru: "Новый код отправлен на #{code_email}. Письмо может прийти через минуту, проверьте и «Спам»." }
                 else
                   { en: flash[:notice].to_s, ru: flash[:notice].to_s }
                 end %>
  <%# inline scripts need the CSP nonce: DocuSeal sends script-src 'self' 'nonce-…' on every GET %>
  <script nonce="<%= content_security_policy_nonce %>">
    (function () {
      var SENT = <%= code_sent ? 'true' : 'false' %>, TEXT = <%= raw json_escape(code_text.to_json) %>, WAIT = 45;
      function msg () { return '✓ ' + (window.SaccadeLang ? window.SaccadeLang.t(TEXT.en, TEXT.ru) : TEXT.en); }
      function run () {
        var form = document.getElementById('code_form'), label = document.getElementById('resend_label');
        if (!form || !label || label.dataset.saccadeWait) return;
        var row = label.closest('.justify-between');
        if (SENT && row && row.firstElementChild) {
          row.firstElementChild.textContent = '';
          var box = document.createElement('div');
          box.setAttribute('role', 'status');
          box.style.cssText = 'margin-top:8px;padding:8px 12px;border-radius:8px;background:#ecfdf3;border:1px solid #abefc6;color:#067647;font-size:14px;line-height:1.4';
          box.textContent = msg();
          row.parentNode.insertBefore(box, row.nextSibling);
          if (window.SaccadeLang) window.SaccadeLang.onChange(function () { box.textContent = msg(); });
        }
        var base = label.textContent.trim(), left = WAIT;
        label.dataset.saccadeWait = '1';
        label.removeAttribute('for');
        label.setAttribute('aria-disabled', 'true');
        label.style.cssText = 'opacity:.45;cursor:default;text-decoration:none';
        (function tick () {
          if (left <= 0) {
            label.textContent = base;
            label.setAttribute('for', 'resend_code');
            label.removeAttribute('aria-disabled');
            label.removeAttribute('style');
            return;
          }
          label.textContent = base + ' (' + left + ' s)';
          left -= 1;
          setTimeout(tick, 1000);
        })();
      }
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run); else setTimeout(run, 0);
    })();
  </script>
<% end %>
<%# Saccade, 2026-11-21: e-mail code field. DocuSeal renders it without autocomplete, so iPhone/Mac do not offer the code
    from Mail above the keyboard. autocomplete="one-time-code" turns that on (Safari; Chrome on Android uses its own rules).
    Covers both code screens: start_form/email_verification and submit_form/email_2fa render this partial. %>
<script nonce="<%= content_security_policy_nonce %>">
  (function () {
    function run () {
      var input = document.querySelector('#code_form input[name*="one_time_code"]');
      if (!input) return;
      input.setAttribute('autocomplete', 'one-time-code');
      input.setAttribute('autocapitalize', 'off');
      input.setAttribute('spellcheck', 'false');
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run); else run();
  })();
</script>
